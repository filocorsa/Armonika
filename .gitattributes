# Normalize line endings to LF in the repository and working tree,
# so scripts and configs work the same on Linux, Docker and Windows.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.webp binary
*.mp3 binary
*.flac binary
*.ogg binary
*.opus binary
*.m4a binary
*.wav binary
*.aiff binary
*.db binary
